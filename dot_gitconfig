[init]
	defaultBranch = main
[user]
	name = Guy Yudovich
	email = guy.yudovich@gmail.com
[core]
	editor = kitty --class "kitty-git-editor" micro
[credential]
	helper = cache
[push]
	default = simple
[alias]
	graph = log --graph --oneline --decorate
	amend = commit --amend --no-edit
[commit]
	gpgsign = true
[pull]
	rebase = true
[advice]
	statusHints = true
	skippedCherryPicks = true
