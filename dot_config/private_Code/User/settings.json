{
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "chat.editor.wordWrap": "on",
    "chat.edits2.enabled": true,
    "chat.mcp.discovery.enabled": {
        "claude-desktop": true,
        "cursor-global": true,
        "cursor-workspace": true
    },
    "chat.mcp.gallery.enabled": true,
    "chat.restoreLastPanelSession": true,
    "chat.useAgentSkills": true,
    "chat.viewSessions.orientation": "stacked",
    "claudeCode.enableNewConversationShortcut": false,
    "claudeCode.preferredLocation": "sidebar",
    "claudeCode.useCtrlEnterToSend": true,
    "cSpell.userWords": [
        "absolufy",
        "alsa",
        "Anki",
        "Cheatsheet",
        "cheatsheets",
        "customise",
        "dartdoc",
        "distros",
        "dotenv",
        "endoflife",
        "envman",
        "fsutils",
        "FURB",
        "GLFW",
        "grayscale",
        "hypr",
        "inodes",
        "kwargs",
        "libc",
        "libcpp",
        "loguru",
        "mypy",
        "namedtuple",
        "nohup",
        "noqa",
        "Pathlib",
        "pavucontrol",
        "Pipewire",
        "pkill",
        "pubspec",
        "pulseaudio",
        "pydantic",
        "Pyflakes",
        "Pylint",
        "pytest",
        "pyvenv",
        "Quickshell",
        "Raylib",
        "Renderable",
        "renderables",
        "RGFW",
        "ricekit",
        "Rustbook",
        "sdist",
        "secho",
        "sqlalchemy",
        "subfolders",
        "Tendenseer",
        "tomli",
        "Toplevel",
        "typer",
        "waybar",
        "Yudovich"
    ],
    "dart.flutterSdkPath": "/home/guy/.flutter/flutter",
    "dependi.vulnerability.ghsa.enabled": true,
    "editor.fontFamily": "monospace",
    "editor.fontLigatures": true,
    "editor.fontVariations": true,
    "editor.formatOnPaste": true,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.wordWrap": "on",
    "editor.wordWrapColumn": 120,
    "errorLens.codeLensEnabled": true,
    "errorLens.enableOnDiffView": true,
    "errorLens.messageEnabled": false,
    "errorLens.onSave": true,
    "evenBetterToml.formatter.arrayTrailingComma": true,
    "evenBetterToml.formatter.trailingNewline": true,
    "explorer.fileNesting.enabled": true,
    "explorer.sortOrder": "type",
    "extensions.autoUpdate": "off",
    "extensions.autoUpdateDelay": 48,
    "files.exclude": {
        "**/.git": false
    },
    "files.trimTrailingWhitespace": true,
    "git.allowForcePush": true,
    "git.alwaysShowStagedChangesResourceGroup": true,
    "git.branchProtection": [
        "master",
        "main"
    ],
    "git.enableCommitSigning": true,
    "git.enableSmartCommit": true,
    "git.mergeEditor": true,
    "git.showPushSuccessNotification": true,
    "git.timeline.showUncommitted": true,
    "github.copilot.enable": {
        "*": true,
        "markdown": true,
        "plaintext": false,
        "scminput": false
    },
    "github.copilot.nextEditSuggestions.eagerness": "auto",
    "github.copilot.nextEditSuggestions.enabled": true,
    "gitlab.duoAgentPlatform.enabled": false,
    "gitlab.duoChat.enabled": false,
    "gitlab.duoCodeSuggestions.enabled": false,
    "indentRainbow.indicatorStyle": "light",
    "inlineChat.notebookAgent": true,
    "Lua.hint.enable": true,
    "markdown-preview-enhanced.previewTheme": "github-dark.css",
    "mermaidChart.showGenerateDiagramCodeLens": false,
    "multiCommand.commands": [
        {
            "command": "multiCommand.restartPythonServers",
            "description": "Restarts language servers for Python, Ty, and Ruff",
            "label": "Restart Servers: Python",
            "sequence": [
                "python.analysis.restartLanguageServer",
                "ty.restart",
                "ruff.restart",
            ]
        }
    ],
    "path-intellisense.showHiddenFiles": true,
    "python-envs.terminal.showActivateButton": true,
    "python.analysis.aiHoverSummaries": true,
    "python.analysis.autoFormatStrings": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.generateWithTypeAnnotation": true,
    "python.analysis.inlayHints.callArgumentNames": "all",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.languageServerMode": "full",
    "python.analysis.showOnlyDirectDependenciesInAutoImport": true,
    "python.analysis.typeEvaluation.enableReachabilityAnalysis": true,
    "python.analysis.typeEvaluation.strictDictionaryInference": true,
    "python.analysis.typeEvaluation.strictListInference": true,
    "python.analysis.typeEvaluation.strictSetInference": true,
    "python.defaultInterpreterPath": "/bin/python",
    "python.languageServer": "Default",
    "python.terminal.activateEnvironment": false,
    "python.testing.pytestEnabled": true,
    "redhat.telemetry.enabled": false,
    "resharper.dataSharing.allowDataSharing": false,
    "ruff.lint.ignore": [
        "D100", // Missing docstring in public module
        "D101", // Missing docstring in public class
        "D102", // Missing docstring in public method
        "D103", // Missing docstring in public function
        "D104", // Missing docstring in public package
        "D105", // Missing docstring in magic method
        "D106", // Missing docstring in public nested class
        "D107", // Missing docstring in public init
        "D203", // Incompatible with D211
        "D212", // Incompatible with D213
        "FURB110", // Fix may modify behavior
        "RET504", // Forbids assigning value to variable right before returning the variable, which is actually a common pattern in programming for ease of debugging.
        "TC001", // Move first-party imports to type-checking block - python 3.15+ supports lazy imports, making this rule unnecessary
        "TC002", // Move third-party imports to type-checking block - python 3.15+ supports lazy imports, making this rule unnecessary
        "TC003", // Move standard library imports to type-checking block - python 3.15+ supports lazy imports, making this rule unnecessary
        "TD002", // Missing todo author
    ],
    "ruff.lint.select": [
        "A", // Protects the Builtin Module
        "ANN", // Enforce Annotations Usage
        "ARG", // Unused Function Arguments
        "ASYNC", // Async
        "B", // Bug Prevention
        "COM", // Comma Related Merge Conflict Prevention
        "C4", // Comprehensions
        "C90", // Complexity
        "D", // Docstring Conventions
        "E", // Code Style (Errors)
        "EM", // Error Messages
        "ERA", // Commented-Out Code
        "F", // Pyflakes
        "FA", // Future Annotations (i.e. `from __future__ import annotations`)
        "FURB", // Miscellaneous (mostly related to code conciseness)
        "I", // Import Order
        "ICN", // Implicit Conventions (e.g. `import pandas as pd` instead of `import pandas`)
        "INP", // Enforce __init__.py Presence in Packages
        "ISC", // Implicit String Concatenation
        "LOG", // Logging
        "G", // Logging Format (specifically for the `logging` module)
        "N", // Naming Conventions
        "PD", // Pandas
        "PGH", // Ignore Specific Rules Instead of Entire Linter (i.e. use specific rule codes in `# noqa` or `# type: ignore`)
        "PIE", // Miscellaneous (mostly related to code redundancy)
        "PL", // Pylint
        "PT", // Pytest
        "PTH", // Prefer Pathlib Over OS Module
        "PYI", // .pyi Stub Files
        "Q", // Quotes
        "RET", // Return Statement
        "RSE", // Exception Raising
        "RUF", // Ruff-Specific Rules
        "S", // Security
        "SIM", // Code Simplicity and Readability
        "SLF", // Forbids Private Member Access
        "SLOT", // Requires `__slots__` For Inheritance From Certain Classes
        "TC", // Type Checking
        "TD", // To-Do Comments
        "TID", // Tidy Imports
        "T10", // Forbid Debug-only Code (e.g. `breakpoint()`)
        "T20", // Prefer Logging Over Print Statements
        "TRY", // Exception Handling
        "UP", // Upgrade Checks and Deprecation Warnings
        "W", // Code Style (Warnings)
    ],
    "rust-analyzer.completion.fullFunctionSignatures.enable": true,
    "rust-analyzer.inlayHints.bindingModeHints.enable": true,
    "rust-analyzer.inlayHints.closureCaptureHints.enable": true,
    "rust-analyzer.inlayHints.closureReturnTypeHints.enable": "always",
    "rust-analyzer.inlayHints.closureStyle": "rust_analyzer",
    "rust-analyzer.inlayHints.discriminantHints.enable": "always",
    "rust-analyzer.inlayHints.expressionAdjustmentHints.enable": "always",
    "rust-analyzer.inlayHints.genericParameterHints.lifetime.enable": true,
    "rust-analyzer.inlayHints.implicitDrops.enable": true,
    "rust-analyzer.inlayHints.implicitSizedBoundHints.enable": true,
    "rust-analyzer.inlayHints.parameterHints.missingArguments.enable": true,
    "rust-analyzer.inlayHints.rangeExclusiveHints.enable": true,
    "rust-analyzer.restartServerOnConfigChange": true,
    "sonarlint.analysisExcludesStandalone": "**/.cache/**,**/typeshed/**",
    "sonarlint.automaticAnalysis": true,
    "sonarlint.disableTelemetry": true,
    "sonarlint.focusOnNewCode": false,
    "sonarlint.rules": {
        "python:S125": {
            "level": "off"
        },
        "python:S3516": {
            "level": "off"
        },
        "python:S3626": {
            "level": "off"
        }
    },
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.confirmOnExit": "hasChildProcesses",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.enableImages": true,
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.env.linux": {
        "VSCODE_TERM": "true"
    },
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontLigatures.featureSettings": "\"calt\" on, \"liga\" on, \"dlig\" on",
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.hideOnStartup": "whenEmpty",
    "terminal.integrated.scrollback": 1000000,
    "terminal.integrated.sendKeybindingsToShell": false,
    "terminal.integrated.shellIntegration.history": 1000,
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.suggest.insertTrailingSpace": true,
    "todo-tree.filtering.includeHiddenFiles": true,
    "trailing-spaces.trimOnSave": true,
    "ty.inlayHints.callArgumentNames": false,
    "ty.inlayHints.variableTypes": false,
    "update.showPostInstallInfo": true,
    "update.titleBar": false,
    "vsicons.dontShowNewVersionMessage": true,
    "window.restoreWindows": "none",
    "workbench.colorCustomizations": {
        // "terminal.background": "#0e1415",
        "editorInlayHint.background": "#3c455c11",
        "editorInlayHint.foreground": "#63636366"
    },
    "workbench.colorTheme": "One Dark Pro Mix",
    "workbench.editorAssociations": {
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.ui": "default",
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.qrc": "qt-core.qrcEditor"
    },
    "workbench.iconTheme": "vscode-icons",
    "workbench.preferredDarkColorTheme": "One Dark Pro Mix"
}